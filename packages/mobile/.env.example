# theStats — packages/mobile env example.
# Copy to .env.local (gitignored) and fill in. Expo inlines EXPO_PUBLIC_*
# values into the app bundle, so never put a secret here.

# Same values as packages/web's NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the theStats web app (serves /api/auth/token and /api/games).
# Leave it empty in development: the app then calls port 3000 on the Mac
# running `expo start` (run `npm run dev` there too), and it keeps working
# when the Mac's IP changes. Set it for release builds, or to use an API
# somewhere else, e.g. the deployed site or when running with `--tunnel`.
EXPO_PUBLIC_API_URL=

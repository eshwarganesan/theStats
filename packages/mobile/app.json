{
  "expo": {
    "name": "theStats",
    "slug": "thestats",
    "version": "0.1.0",
    "platforms": [
      "ios"
    ],
    "orientation": "landscape",
    "icon": "./assets/images/icon.png",
    "scheme": "thestats",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0D",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "app.thestats.ios",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f29f6fd8-87fc-4624-813d-421928cd22a3"
      }
    },
    "owner": "eshwarg"
  }
}

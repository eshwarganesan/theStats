{
  "expo": {
    "name": "theStats",
    "slug": "thestats",
    "version": "0.1.0",
    "platforms": [
      "ios"
    ],
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "thestats",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.thestats.ios"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
